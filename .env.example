# Settings for docker-compose.yml. Copy to .env and change the password.
# .env is git-ignored: never commit real secrets.

POSTGRES_USER=sms_user
# Use letters and numbers only: the password is placed inside DATABASE_URL.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sms_db

# Host port for the website (http://localhost:80)
HTTP_PORT=80

# --- Set by the CI/CD deploy job on the server (leave commented locally) ---
# BACKEND_IMAGE=ghcr.io/<github-user>/sms-backend
# FRONTEND_IMAGE=ghcr.io/<github-user>/sms-frontend
# IMAGE_TAG=<commit-sha>
